# ===================================================
# TASK TRACKER KULIAH - ENVIRONMENT VARIABLES
# ===================================================

# 1. GOOGLE SHEETS API
# ID Spreadsheet Google Sheets Anda (diambil dari URL: https://docs.google.com/spreadsheets/d/[SHEET_ID]/edit)
GOOGLE_SHEET_ID="your_google_sheet_id_here"

# Kredensial Service Account Google:
# Opsi A: Menggunakan Email & Private Key
GOOGLE_SERVICE_ACCOUNT_EMAIL="your-service-account@your-project.iam.gserviceaccount.com"
GOOGLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# Opsi B (Alternatif Opsi A): Seluruh isi file JSON Service Account dalam satu baris string
# GOOGLE_SERVICE_ACCOUNT_KEY='{"type": "service_account", "project_id": "...", ...}'

# 2. TELEGRAM BOT
# Token bot dari @BotFather
TELEGRAM_BOT_TOKEN="123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ"

# Secret Token untuk webhook Telegram (string acak untuk mengamankan endpoint /api/telegram/webhook)
TELEGRAM_BOT_SECRET="my_super_secret_webhook_token_12345"

# Whitelist Telegram User ID / Chat ID milik Anda (bot akan menolak perintah dari user lain)
# Jalankan bot dan kirim /start untuk mengetahui Chat ID Anda
TELEGRAM_ALLOWED_USER_ID="123456789"

# 3. CRON JOB REMINDER (VERCEL CRON)
# Secret untuk otentikasi Vercel Cron job ke endpoint /api/cron/check-deadlines
CRON_SECRET="my_cron_secret_token_12345"

# 4. WEB DASHBOARD SECURITY (OPSIONAL)
# Jika diisi, web dashboard akan meminta kata sandi ini sebelum membuka dashboard
# APP_PASSWORD="password_rahasia_anda"
